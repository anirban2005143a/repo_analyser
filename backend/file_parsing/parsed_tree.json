  {"type": "function",
   "name": "timer",
   "start_line": 287,
   "end_line": 302,
   "text": "def timer(function):\r\n\r\n    @wraps(function)\r\n    def wrapper(*args, **kwargs):\r\n\r\n        start = time.time()\r\n\r\n        result = function(*args, **kwargs)\r\n\r\n        end = time.time()\r\n\r\n        print(f\"{function.__name__} \" f\"took {end - start:.4f} seconds\")\r\n\r\n        return result\r\n\r\n    return wrapper",
   "children": [{"type": "function",
